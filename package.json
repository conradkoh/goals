{
  "name": "next-convex-starter-app",
  "version": "1.2.0",
  "description": "Goal tracking application with hierarchical goal management",
  "packageManager": "pnpm@10.15.1",
  "main": "index.js",
  "scripts": {
    "pretest": "bash scripts/kill-stale-vitest.sh",
    "pretest:watch": "bash scripts/kill-stale-vitest.sh",
    "test": "turbo run test",
    "test:scripts": "bun test scripts/",
    "test:watch": "turbo run test:watch",
    "test:kill-stale": "bash scripts/kill-stale-vitest.sh",
    "dev": "turbo run dev",
    "setup": "bun scripts/setup.ts",
    "build": "turbo run build",
    "migrate": "bun scripts/migrate.ts",
    "start-convex-dev": "bun scripts/start-convex-dev.ts",
    "check:upstream-modifications": "bun scripts/check-upstream-modifications.ts",
    "fix:convex-stale-exports": "bun scripts/fix-convex-stale-exports.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "clean": "find . -name 'node_modules' -type d -prune -exec trash {} +",
    "find-deadcode": "fallow dead-code --baseline .fallow/baseline.json",
    "code-audit": "fallow audit --dead-code-baseline .fallow/baseline.json",
    "code-quality": "fallow",
    "code-quality:fix": "fallow fix --dry-run",
    "e2e": "turbo run e2e",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^20.17.24",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "bun": "^1.3.14",
    "eslint": "^9.26.0",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.9.2",
    "fallow": "^2.85.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bun",
      "esbuild",
      "sharp",
      "turbo",
      "unrs-resolver"
    ]
  }
}
